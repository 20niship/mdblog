<!DOCTYPE html>
<!-- 
変数
- main
  - title : タイトル（string) 
  - description : Wikiの説明
  - showMenu : メニューバーの表示（T/F
- icons : ファビコンなど
  - shortcut_icon
  - apple_touch_icon
  - favicon 
- render_goto_top : ページトップに移動するアイコンを表示するかどうか（T/F）
-->

<htmL>
<head>
  <meta charset="UTF-8">
  <link rel="stylesheet" type="text/css" href="/public/css/styles.css" />
  <link href="https://use.fontawesome.com/releases/v5.6.1/css/all.css" rel="stylesheet">
 
  <!-- ソースコードのハイライト -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.0.1/styles/default.min.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.0.1/highlight.min.js"></script>

  <!-- Tex形式の数式をきれいに表示する -->
  <script type="text/javascript" src="http://cdn.mathjax.org/mathjax/latest/MathJax.js?config=TeX-AMS-MML_HTMLorMML"></script>

  <link href="https://vjs.zencdn.net/7.15.4/video-js.css" rel="stylesheet" />
  
  <script src="/public/js/parser.js" type="text/javascript"></script>
  <script src="/public/js/toc_creator.js" type="text/javascript"></script>
  <script src="/public/js/mymessage.js" type="text/javascript"></script>

  <meta name="viewport" content="width=device-width,initial-scale=0.7,minimum-scale=0.7, maximum-scale=1.0" />

  <meta name="description" content="Free Web tutorials">
  <meta name="keywords" content="HTML, CSS, JavaScript">
  <meta name="author" content="John Doe">

  <meta property="og:title" content="<%- main.title_txt && '' %>" />
  <meta property="og:type" content="post" >
  <meta property="og:description" content="<%- page.title_txt && '' %>" >
  <meta property="og:url" content="<%-main.domain && '' %>/view/<%- page.title_txt  && ''%>" >
  <meta property="og:image" content="<%- page.icon && '' %>" >
  <meta property="og:site_name" content="<%- main.title && '' %>" >

  <title><%- main.title %></title>
</head>

<body>
  <div id="pagetop" style="width:0;height:0"></div>
  <header>
    <div class="header_wrapper">
      <div class="header_start">
        <img src="/file/logo.png" width=50 class="h_logo"/>
        <a href="/" class="h_title"><%- main.title %></a>
        <span class="h_desc">description here</span>
      </div>

      <div class="header_end">
        <div class="h_search">
          <form action = "/search" class="search-form" method = “get”>
            <input type="text" class="searchTerm" name="q" placeholder="What are you looking for?">
            <input type="submit" class="searchButton" value="&#xf002">
          </form>
        </div>
        
        <nav class="header_nav">
          <label for="show-header-menu" class="show-header-menu-label"><i class="fa fa-bars"></i></label>
          <input type="checkbox" id="show-header-menu" role="button">
          <div class="hmenu-bg" onclick="document.getElementById('show-header-menu').checked = false;"></div>
          <ul class="h_nav_wrapper">
            <li><a href="/">Home</a></li>
            <li>
              <!-- <a href="#">WorkShop</a> -->
              <input type="checkbox" id="show-h-menu-1" role="button">
              <label for="show-h-menu-1" class="show-header-menu-child-label">WorkShop</label>
                <ul>
                    <li><a href="#">投擲班</a></li>
                    <li><a href="#">Swerve班</a></li>
                    <li><a href="#">ROS2班</a></li>
                    <li><a href="#">機械屋</a></li>
                    <li><a href="#">回路屋</a></li>
                    <li><a href="#">制御屋</a></li>
                </ul>
            </li>
            <li>
              <input type="checkbox" id="show-h-menu-2" role="button">
              <label for="show-h-menu-2" class="show-header-menu-child-label">RC2021</label>
              <ul>
                <li><a href="#">投擲班</a></li>
                <li><a href="#">Swerve班</a></li>
                <li><a href="#">ROS2班</a></li>
                <li><a href="#">機械屋</a></li>
                <li><a href="#">回路屋</a></li>
                <li><a href="#">制御屋</a></li>
              </ul>
            </li>
            <li>
              <input type="checkbox" id="show-h-menu-3" role="button">
              <label for="show-h-menu-3" class="show-header-menu-child-label">F3RC</label>
              <ul>
                <li><a href="#">A班</a></li>
                <li><a href="#">B班</a></li>
                <li><a href="#">C班</a></li>
                <li><a href="#">D班</a></li>
                <li><a href="#">E班</a></li>
                <li><a href="#">F班</a></li>
                <li><a href="#">その他</a></li>
              </ul>
            </li>
            <li>
              <input type="checkbox" id="show-h-menu-4" role="button">
              <label for="show-h-menu-4" class="show-header-menu-child-label">User</label>
              <ul>
<% if (main.username !== 'undefined') { %>
            <li><a href="/user/logout">Logout</a></li>
            <li><a href="/mypage">マイページ</a></li>
<% } else { %>
            <li><a href="/user/login">Login</a></li>
<% } %>

<% if (main.username && main.username.indexOf('guest')>=0) { %>
  <li><a href="/user/login">Login</a></li>
  <li><a href="/user/logout">Register</a></li>
<% } %>
                <li><a href="myedit">最近編集した記事</a></li>
              </ul>
            </li>
            <li>
            <input type="checkbox" id="show-h-menu-6" role="button">
            <label for="show-h-menu-6" class="show-header-menu-child-label">System</label>
            <ul>
              <li><a href="/special/performance">プロファイリング</a></li>
              <li><a href="/special/config">About</a> </li>
              <li><a href="/special/config/user">ユーザー設定</a> </li>
              <li><a href="/special/config/usergroup">グループ設定</a></li>
              <li><a href="/special/config/page">/ページ設定</a> </li>
            </ul>
          </li>
          </ul>
        </nav>
      </div>
    </div>
  </header>

  <section class="main-view">
    <input id="slide-opener" type="checkbox" role="button" />
    <label for="slide-opener" id="side-opener-label">
      <i class="fas fa-bars"></i>
    </label> 
   
    <aside class="sidenav">
      <div class="side-menu-fixed">
        <table>
          <tr>
            <td>
              <input type="radio" id="sidenav_history" class="nodisplay" name="sidemenu" >
              <label for="sidenav_history"><i class="fas fa-history"></i><p>Recent</p></label>
            </td>
            <td>
              <input type="radio" id="sidenav_search" class="nodisplay" name="sidemenu" >
              <label for="sidenav_search"><i class="fas fa-search"></i><p>Search</p></label>
            </td>
            <td>
              <input type="radio" id="sidenav_star" class="nodisplay" name="sidemenu" >
              <label for="sidenav_star"><i class="fas fa-star"></i><p>Favorite</p> </label>
            </td>
            <td>
              <input type="radio" id="sidenav_mypage" class="nodisplay" name="sidemenu"  >
              <label for="sidenav_mypage"><i class="fas fa-user"></i><p>Mypage</p></label>
            </td>
            <td>
              <input type="radio" id="sidenav_myedit" class="nodisplay" name="sidemenu"  >
              <label for="sidenav_myedit"><i class="fas fa-pen"></i><p>MyEdit</p></label>
            </td>
          </tr>
        </table>
      </div>
      <div class="side-scroll">
          <section id="sidenav-content"></section>
      </div>
    </aside>
    <main class="main-content">
<% if (main.type === 'page') { %>
  <div class="page-status-wrapper">
    <% if (page.page_found) { %>
      <a href="/search?d=<%- page.c_date %>" class="date"><i class="fas fa-clock icon"></i><%- page.c_date %></a> 
      <a href="/search?d=<%- page.m_date %>" class="date"><i class="fas fa-code-branch"></i><%- page.m_date %></a>
      <% page.category.forEach((cat) => { if (cat !== null) { %> <a href="/search?c=<%- cat %>" class="category"><%- cat %></a><% } }) %>
    <% } %>
  </div>
  
  <div class="page-title-wrapper"><span class="page-title"><%- page.title %></span>
    <% if (page.hasEditRight && page.page_found) { %>
    <input type="button" value="Edit" onclick="window.location = window.location.pathname + '?action=edit';" class="text-button" />
    <% } %>
    <input type="button" value="New" onclick="{document.getElementById('popup-new-page').style.display = 'block';}" class="text-button" />
  </div>
  
  <div id="mainText">
    <% if (page.page_found) { %>
      <div id="toc"></div>
      <div id="post-content"><%- page.html_text %></div>
    <% }else{ %>
      <span style='font-size:300%;font-weight:bold;'>Page Not Found!</h1>
      <p>Oops! Requested Page is not created or deleted!</p>
      <p> <a href='/'>goto HOME</a></p>
    <% } %>
  </div>

  <div class="popup new-page" id="popup-new-page" style="display: none;">
    <div class="popup-inner my-form">
      <button class="popup-close-btn" onclick="{document.getElementById('popup-new-page').style.display = 'none';}"><i class="fas fa-times"></i></button>
      <p class="my-form-title">新しいページを作成</p>
      <table>
        <tr style="background:none;"><td><spqn>自分のページ内で作成</spqn></td><td></td></tr>
        <tr class="my-form-oneline">
          <td><span><i class="fas fa-home"></i>/user/<%- main.username %>/<input type="text" id="f_page_title_0" value=""></spa></td>
          <td><button class="form-submit-btn" onclick="create_new_page('user/<%- main.username %>/', 0)">作成</button></td>
        </tr>

        <tr style="background:none;"><td><spqn>現在の場所から作成</spqn></td><td></td></tr>
        <tr class="my-form-oneline">
          <td><i class="fas fa-home"></i>/<span><%- page.title_txt %></span>/<input type="text" id="f_page_title_1" value=""></td>
          <td><button class="form-submit-btn" onclick="create_new_page('<%- page.title_txt %>/', 1)">作成</button></td>
        </tr>

        <tr style="background:none;"><td><spqn>その他</spqn></td><td></td></tr>
        <tr class="my-form-oneline">
          <td><i class="fas fa-home"></i>/<input type="text" id="f_page_title_2" value=""></td>
          <td><button class="form-submit-btn" onclick="create_new_page('', 2)">作成</button></td>
        </tr>
      </table>
      <p id="create-new-page-err-msg" style="color:#f22;"></p>

      <p>新しいページのタイトルを入力し、「作成」ボタンを押して下さい。</p>
      <p>同名のページを複数作ることはできません</p>
    </div>
  </div>

<% } else if (main.type === 'search') { %>
  <span style="font-size:1.2rem;text-decoration:none;font-weight:normal;">

    <% if ('q' in query) { %>
      <span style="font-weight: bold;"><%- query.q %> </span>の検索結果
    <% }else if ('c' in query) { %>
      カテゴリー：<span style="font-weight: bold;"><%- query.c %> </span>の検索結果
    <% }else if ('dir' in query) { %>
      <i class="fas fa home"></i>/<a href="/view/<%- query.dir %> " style="font-weight: bold;"><%- query.dir %> </a>内の検索結果
    <% } %>
    
    <p>全&nbsp;<%- nfound %>&nbsp;件中&nbsp;<%- nresult %>&nbsp;件を表示</p>

    <nav aria-label="pagination" class="pnavigation-nav">
      <ul class="pagination">
          <li><a href="">«</a></li>
          <li><a href="">1</a></li>
          <li><a href="">2</a></li>
          <li><a href="">3</a></li>
          <li><a href="">4</a></li>
          <li><a href="">5</a></li>
          <li><a href="">»</a></li>
      </ul>
  </nav>
  <style>
    .pnavigation-nav {
      display: flex;
      justify-content: center;
    }
            
    .pagination {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
    }
            
    .pagination li {
      margin: 2px;
      padding:0;
      width:50px;
      height:50px;
      border: solid 1px #fff;
      border-radius: 5px;
    }
    .pagination li,
    .pagination li  a {
      color:#fff;
      font-size: 30px;
      line-height: 50px;
      text-decoration: none;
      text-align: center;
    }

    .visuallyhidden{
      font-size: 0px;
      visibility: hidden;
    }
  </style>

    <p>詳細条件：</p>
    <ul>
      <% if ('c' in query) { %>
        <li>カテゴリー   :  <%- query.c %> </li>
      <% } if ('dir' in query) { %>
        <li>ディレクトリ   :  <%- query.dir %> </li>
      <% } if ('drange' in query) { %>
        <li>記事作成範囲   :  <%- query.drange %> </li>
      <% } if ('d' in query) { %>
        <li>記事作成日   :  <%- query.d %> </li>
      <% } if ('sort' in query) { %>
        <li>並び順   :  
          <% if (query.sort === "create_r") { %> 記事作成日（降順）
          <% } else if (query.sort === "create") { %> 記事作成日
          <% } else if (query.sort === "update") { %> 最後の編集日
          <% } else if (query.sort === "update_r") { %> 記事作成日（降順）
          <% } else if (query.sort === "nvisited") { %> 閲覧回数
          <% } else if (query.sort === "nvisited_r") { %> 閲覧回数（降順）
          <% } else if (query.sort === "nword") { %> 単語数（降順）
          <% } else if (query.sort === "nword_r") { %> 単語数
          <% } else { %> UNDEFINED?? <% } %> </li>
      <% } if ('d' in query) { %>
        <li>記事作成日   :  <%- query.d %> </li>
      <% } %>
    </ul>
  </span>
  
  <details class="detail-search">
    <summary>詳細検索</summary>
    <form class="my-form my-form-oneline" action="/search">
      <div class="search-ui-component">
          <label for="search-q float-left">検索する語句</label>
          <input type="text" class="float-left" id="search-q" name="q" placeholder="What are you looking for?" value= <%- query.q %> >
      </div>
      <div class="search-ui-component">
          <label for="search-aq float-left">除外する語句</label>
          <input type="text" class="float-left" id="search-aq" name="aq" readonly placeholder="501 Not implemented" value= <%- query.aq %> >
      </div>
      <div class="search-ui-component">

        <label for="search-dir" class="float-left" >検索場所</label>
        <input type="text" name="dir" id="search-dir" list="search_dir_datalist" class="float-left" value= <%- query.dir %> >
        <datalist id="search_dir_datalist">
          <option value="">全範囲</option>
          <option value="RC2022/WorkShop2022"></option>
          <option value="RC2021/WorkShop2021"></option>
          <option value="RC2020/WorkShop2020"></option>
          <option value="RC2019/WorkShop2019"></option>
          <option value="RC2018/WorkShop2018"></option>
          <option value="RC2017/WorkShop2017"></option>
          <option value="RC2016/WorkShop2016"></option>
          <option value="RC2015/WorkShop2015"></option>
          <option value="RC2014/WorkShop2014"></option>
          <option value="RC2021">RC2021</option>
          <option value="RC2020">RC2020</option>
          <option value="RC2019">RC2019</option>
          <option value="RC2018">RC2018</option>
          <option value="RC2017">RC2017</option>
          <option value="RC2016">RC2016</option>
          <option value="RC2015">RC2015</option>
          <option value="RC2014">RC2014</option>
          <option value="RC2013">RC2013</option>
          <option value="F3RC^2021">F3RC2022</option>
          <option value="F3RC^2020">F3RC2021</option>
          <option value="F3RC^2019">F3RC2020</option>
          <option value="F3RC^2018">F3RC2019</option>
          <option value="F3RC^2017">F3RC2018</option>
          <option value="春ロボ2021">春ロボ2021</option>
          <option value="春ロボ2020">春ロボ2019</option>
          <option value="春ロボ2019">春ロボ2018</option>
          <option value="春ロボ2018">春ロボ2017</option>
          <option value="春ロボ2017">春ロボ2016</option>
          <option value="admin">admin</option>
        </datalist>
     </div>
      <div class="search-ui-component">
        <label for="search-c" class="float-left">カテゴリー</label>
          <select name="c" id="search-c" size="1" class="float-left" value=<%- query.c %> >
          <option value="">未選択</option>
          </select>
          <script>
            (async() => {
              let cat_el = document.getElementById("search-c");
              category_datalist = ""
              const response = await fetch("/api/component?query=category&format=json")
              if(response.ok){
                const res_json = (await response.json())["categories"];
                for (i in res_json){
                  category_datalist += `<option value="${res_json[i]}">${res_json[i]}</option>`
                }
                cat_el.innerHTML = "<option value=''>未選択</option>" + category_datalist;
              }
            })()
          </script>
      </div>
      <div class="search-ui-component">
        <label for="search-sort" class="float-left">並び替え</label>
        <select name="sort" id="search-sort" size="1" class="float-left" value=<%- query.sort %>>
        <option value="">未選択</option>
        <option value="create">作成日時</option>
        <option value="create_r">作成日時（降順）</option>
        <option value="modify">最終更新日時</option>
        <option value="modify_r">最終更新日時（降順）</option>
        <option value="nword">単語数</option>
        <option value="nword_r">単語数（降順）</option>
        <option value="nvisited">閲覧数</option>
        <option value="nvisited_r">閲覧数（降順）</option>
        <option value="title">タイトル</option>
        <option value="title_r">タイトル（降順）</option>
        </select>
    </div>

      <div class="search-ui-component">
        <link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
          <script src="https://code.jquery.com/jquery-1.12.4.js"></script>
          <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
          <label for="drange">記事作成日</label>
          <input type="text" id="drange" name="drange" readonly placeholder="SELECT RANGE">
      </div>
      <div id="slider-range"></div>
        <script>
            $( "#slider-range" ).slider({
              range: true,
              min: new Date('2000-01-01T00:00:00').getTime(),
              max: Date.now(),
              step: 864,
              values: [ new Date('2000-03-01T00:00:00').getTime(), Date.now() ],
              slide: function( event, ui ) {
                let from = new Date(ui.values[0])
                let to   = new Date(ui.values[1])
                let from_str = from.getUTCFullYear() + '/' + ('0' + (from.getUTCMonth() + 1)).slice(-2);
                let to_str   =   to.getUTCFullYear() + '/' + ('0' + (  to.getUTCMonth() + 1)).slice(-2);
                $( "#drange" ).val(from_str + " - " + to_str);
              }
            });
        </script>

      <input type="submit" value="再検索" class="favorite styled"></input>
    </form>
  </details>
  <script>
      const el = document.getElementsByClassName("detail-search")[0];
      el.open  = true;
  </script>
  
  <div class="search-result">
    <%- result_html %>
  </div>
    
<% } else { %>
    <h1>Internal Server Error</h1>
<% } %>
    </main>
  </section>

  <% if (page.render_goto_top) { %>
    <div id="goto-top"><span class="page-top-icon"><a href="#pagetop"> TOP </a></span></div>
  <% } %>

  <% if (page.render_lgtm_btn) { %>
  <label id="lgtm-btn" onclick="favorite()"><i class="fas fa-star" id="lgtm-btn-icon"></i><span  class="fa fa-stack-1x">
  <span>ふぁぼ</span></span></label>
  <% } %>

  <footer>
    <ul class="footer-menu">
        <li><a href="/">home</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/content">Contact</a></li>
        <li><a href="/follow">Follow</a></li>
    </ul>
    <p class="footer-copyright">&copy;All rights reserved by webcampnavi.</p>
  </footer>
</body>
<script src="/public/js/client_view.js" type="text/javascript"> </script>
</htmL>
