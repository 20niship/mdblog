<!DOCTYPE html>
<html>
<head>
<title>Markdown Editor</title>
<meta charset="utf-8">
<script src="/static/js/codemirror.js"></script>
<script src="/static/js/continuelist.js"></script>
<script src="/static/mode/markdown.js"></script>
<script src="/static/mode/xml.js"></script>
<link href="https://use.fontawesome.com/releases/v5.6.1/css/all.css" rel="stylesheet">
<script src="/socket.io/socket.io.js"></script>
<link rel="stylesheet" href="/static/css/00-codemirror.css">
<link rel="stylesheet" href="/static/css/monokai.css">
<link rel="stylesheet" href="/static/css/editor.css">
<link rel="stylesheet" href="/static/css/styles.css">
<script src="/static/js/parser.js" type="text/javascript"></script>
<script src="/static/js/mymessage.js" type="text/javascript"></script>

<meta name="viewport" content="width=device-width,initial-scale=0.7,minimum-scale=0.7, maximum-scale=1.0" />

<meta name="description" content="Markdown Editor ver 1.0">
<meta name="keywords" content="Markdown">
<meta name="author" content="20niship">

<meta property="og:title" content="Markdown Editor" />
<meta property="og:type" content="post" >
<meta property="og:description" content="Markdown Editor ver 1.0" >
</head>
<body>
<header>
  <div class="editor-menu">
    <div class="menu-btn-list">
      <span class="page-title-editor"><%- page.title %></span>
      <button id="openNav" class="text-button" onclick="save()">保存</button>
      <button id="openNav" class="text-button" onclick="exitWithoutSave()">終了</button>

      <input type="radio" id="btn_mode_view" name="view" class="nodisplay" value="mode_View" onclick="setVisualMode()" >
      <label for="btn_mode_view" class="editor-mode-label"><i class="fas fa-eye"></i></label>
      
      <input type="radio" id="btn_mode_both" name="view" class="nodisplay" value="mode_Both" onclick="setVisualMode()" checked>
      <label for="btn_mode_both" class="editor-mode-label"><i class="fas fa-columns"></i> </label>

      <input type="radio" id="btn_mode_edit" name="view" class="nodisplay" value="mode_Edit" onclick="setVisualMode()">
      <label for="btn_mode_edit" class="editor-mode-label"><i class="fas fa-pen-nib"></i></label>
    </div>
  </div>
</header>

<main  class="main" id="main">
<div class="editor">
    <textarea id="editor"></textarea>
</div>

<div class="preview">
    <iframe id="preview"></iframe>
</div>
<div style="clear:both;"></div>
</main>

<aside class="sidebar" id="sidebar">
  <div class="e-sidebar-menu-buttons">
    <div class="e-sidebar-menu-buttons-w">
      <input type="radio" id="sidebar_menu_image" class="nodisplay" name="sidemenu" onclick="toggleSidebar('image')" >
      <label for="sidebar_menu_image"><i class="fas fa-image"></i></label>
      
      <input type="radio" id="sidebar_menu_setting" class="nodisplay" name="sidemenu" onclick="toggleSidebar('setting')">
      <label for="sidebar_menu_setting"><i class="fas fa-cog"></i> </label>

      <input type="radio" id="sidebar_menu_folder" class="nodisplay" name="sidemenu" onclick="toggleSidebar('file')">
      <label for="sidebar_menu_folder"><i class="fas fa-folder"></i></label>

      <input type="radio" id="sidebar_menu_view" class="nodisplay" name="sidemenu" onclick="toggleSidebar('view')">
      <label for="sidebar_menu_view"><i class="fas fa-eye"></i> </label>

      <input type="radio" id="sidebar_menu_edit" class="nodisplay" name="sidemenu" onclick="toggleSidebar('edit')">
      <label for="sidebar_menu_edit"><i class="fas fa-edit"></i></label>
    </div>
  </div>
  <div class="e-sidebar-main-content" id="e-sidebar-main-content">
    <div class="e-sidebar-main-content-inner">
      <section id="editor-side-sec-main">
      </section>
      <section id="editor-side-sec-loading">
        <h1>　Now Loading......</h1>
        <p>　Please wait for a minute.....</p>
      </section>
    </div>
  </div>
</aside>
<div id="loader-wrapper">
  <div class="loader-wrapper-2">
    <div class="cubes">
      <div class="sk-cube sk-cube1"></div>
      <div class="sk-cube sk-cube2"></div>
      <div class="sk-cube sk-cube3"></div>
      <div class="sk-cube sk-cube4"></div>
      <div class="sk-cube sk-cube5"></div>
      <div class="sk-cube sk-cube6"></div>
      <div class="sk-cube sk-cube7"></div>
      <div class="sk-cube sk-cube8"></div>
      <div class="sk-cube sk-cube9"></div>
     </div>

    <p>Waiting for connection....</p>
  </div>
</div>
<script src="/static/js/client_edit.js" type="text/javascript"></script>
</body>
</html>