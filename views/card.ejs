<!doctype html>
<%# 
変数
- title
- content
- c_date : created date
- m_date : modified date
- category : category list 
- content_short : 一部内容表示
%>


<div class="card-link">
<a href="/search?d=<%- c_date %>" class="date"><i class="fas fa-clock icon"></i><%- c_date %></a>
<a href="/search?d=<%- m_date %>" class="date"><i class="fas fa-code-branch"></i><%- m_date %></a>
<% tag.forEach((c) => { if (c !== null) { %> 
  <a href="/search?c=<%- c %>" class="category"><%- c %></a>
<% } }) %>
<div width="100%"></div>
<a href="/view/<%- url %>">
<img src="<%- icon %>" alt="<%- title %>" class="card-link-thumb" onerror="this.classList.add('undefined-img')"></a>
<p class="card-link-title"><a href="/view/<%- url %>"><%- title %></a></p>
<p class="card-link-desc"> <%- content_short %></p>
</div>


